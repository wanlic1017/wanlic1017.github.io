VITE_APP_URL=https://your-site.example.com
VITE_FUNCTIONS_BASE_URL=https://your-region-your-project.cloudfunctions.net

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_FORMAT=png
OPENAI_IMAGE_CONCURRENCY=1
OPENAI_TEXT_MODEL=gpt-5.4-mini

# Firebase Functions / Stripe checkout. Keep real values in your local
# Functions environment, not in source control.
STRIPE_PRACTICE_PRICE_ID=price_your_practice_price_id
STRIPE_FULL_ACCESS_PRICE_ID=price_your_full_access_price_id
STRIPE_MODULE_HUBS191_TISSUES_AND_MOVEMENT_PRICE_ID=price_your_hubs191_tissues_and_movement_price_id
STRIPE_MODULE_HUBS191_MUSCULOSKELETAL_PRICE_ID=price_your_hubs191_musculoskeletal_price_id
STRIPE_MODULE_HUBS191_BIO_STATISTICS_PRICE_ID=price_your_hubs191_bio_statistics_price_id
STRIPE_MODULE_HUBS191_NERVOUS_SYSTEM_PRICE_ID=price_your_hubs191_nervous_system_price_id
STRIPE_MODULE_HUBS191_ENDOCRINE_SYSTEM_PRICE_ID=price_your_hubs191_endocrine_system_price_id
STRIPE_MODULE_HUBS191_IMMUNE_SYSTEM_PRICE_ID=price_your_hubs191_immune_system_price_id
STRIPE_MODULE_CELS191_CELL_STRUCTURE_AND_DIVERSITY_PRICE_ID=price_your_cels191_cell_structure_and_diversity_price_id
STRIPE_MODULE_CELS191_MOLECULAR_BIOLOGY_AND_GENETICS_PRICE_ID=price_your_cels191_molecular_biology_and_genetics_price_id
STRIPE_MODULE_CELS191_HUMAN_MOLECULAR_GENETICS_PRICE_ID=price_your_cels191_human_molecular_genetics_price_id
STRIPE_MODULE_CELS191_MICROBIOLOGY_PRICE_ID=price_your_cels191_microbiology_price_id
# Optional alternative: provide a single JSON price map instead of individual vars.
STRIPE_PRICE_MAP_JSON={}
APP_URL=https://your-site.example.com
APP_ALLOWED_ORIGINS=https://your-site.example.com,http://localhost:5173
APP_CHECK_ENFORCED=false

VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
# Keep false until App Check is fully configured and verified in production.
VITE_FIREBASE_APPCHECK_ENABLED=false
VITE_FIREBASE_APPCHECK_SITE_KEY=your_recaptcha_v3_site_key
# Optional for local development only. Leave blank in production.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
