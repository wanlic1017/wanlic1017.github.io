{
  "name": "haerenga-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "/opt/anaconda3/bin/python3 scripts/build_cels_enhanced_notes.py && /opt/anaconda3/bin/python3 scripts/build_cels_extra_resources.py && /opt/anaconda3/bin/python3 scripts/build_hubs_extra_resources.py && /opt/anaconda3/bin/python3 scripts/build_resource_library.py && tsc -b && vite build && node scripts/prune-dist-large-files.js",
    "build:web": "tsc -b && vite build && node scripts/prune-dist-large-files.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "bash scripts/deploy-gh-pages.sh",
    "deploy:web": "BUILD_SCRIPT=build:web bash scripts/deploy-gh-pages.sh",
    "add-protips": "node addProTips.js",
    "upgrade-explanations": "node upgradeExplanations.js"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.7.0",
    "framer-motion": "^12.38.0",
    "openseadragon": "^6.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.10",
    "protobufjs": "^7.5.5",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.5"
  }
}
